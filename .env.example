# ============================================================
# FarmConnect - Environment Variables Template
# Copy this file to .env and fill in real values.
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ============================================================

# Server Port (assigned automatically on Render, fallback 8080 locally)
PORT=8080

# Active Spring Profile: 'mailpit' (local dev) or 'gmail' (cloud / production)
SPRING_PROFILES_ACTIVE=mailpit

# Database Configuration (Aiven MySQL in production)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/farmconnect_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_local_database_password

# SQL Logging (optional, defaults to false)
SHOW_SQL=false

# JWT Signing Secret (must be 32+ characters / 256+ bits)
JWT_SECRET=your_long_random_development_secret

# Password Reset Base URL (e.g. https://your-service.onrender.com)
RESET_BASE_URL=http://localhost:8080

# Gmail SMTP (Required when SPRING_PROFILES_ACTIVE=gmail)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
